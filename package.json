{
  "name": "metro-sports-scraper",
  "version": "1.0.0",
  "description": "Scrapes Metro Sports (metrosports.co.in) product catalog via the WooCommerce Store API, stores/updates data in MongoDB, and runs on a 24-hour schedule.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "scrape": "node src/index.js --once",
    "dev": "nodemon src/index.js"
  },
  "keywords": [
    "scraper",
    "woocommerce",
    "mongodb",
    "mern"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "html-entities": "^2.6.0",
    "mongoose": "^8.9.5",
    "node-cron": "^3.0.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
